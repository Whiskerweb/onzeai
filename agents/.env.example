# ─── Supabase (même projet que web/bot) ───
SUPABASE_URL=https://thcwlydkvkbahospltoo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Pousse de pick (réutilise l'endpoint Vercel /api/picks) ───
PICKS_INGEST_URL=https://akyra.io/api/picks
PICKS_INGEST_SECRET=

# ─── LLM analyse ───
# 2 modes :
#   LLM_BACKEND=cli  → invoque `claude -p` headless (abo Max Lucas, gratuit, recommandé MVP)
#                       Auth requis : sur la VM, run `claude login` 1× avec compte Lucas.
#                       ANTHROPIC_API_KEY peut rester vide.
#   LLM_BACKEND=api  → SDK @anthropic-ai/sdk, facturé au token via clé API.
#                       ANTHROPIC_API_KEY requis.
#   LLM_BACKEND=auto (défaut) → CLI si pas d'API key, API sinon.
LLM_BACKEND=auto
ANTHROPIC_API_KEY=                  # optionnel, vide = CLI mode
ANALYZE_MODEL=claude-haiku-4-5      # ignoré en CLI (Claude Code utilise son modèle)
CLAUDE_CLI_PATH=                    # optionnel, default 'claude' depuis PATH

# ─── Embeddings (news_items) — phase 2 RAG chat ───
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# ─── Data sources ───
ODDS_API_KEY=                        # the-odds-api.com (free 500/mois)
FOOTBALL_DATA_TOKEN=                 # football-data.org (free 10/min)
BALLDONTLIE_API_KEY=                 # balldontlie.io (free, optional pour basic)

# ─── Comportement ───
DRY_RUN=0                            # 1 pour bloquer tous les pushes (analyse seule)
PUSH_DAILY_CAP_PER_COACH=2           # safety cap : max N picks/jour/coach
MIN_EDGE_PCT=4                       # gate min edge (%) pour push
LOG_LEVEL=info                       # pino level
